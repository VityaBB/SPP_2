{
  "name": "lab3-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API с ролевой моделью доступа, временными ключами и структурированным логированием (лабораторная работа №3)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\"",
    "lint:client": "node --check ../client/public/app.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "check": "npm run lint && npm run lint:client && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "supertest": "^7.1.0"
  }
}
